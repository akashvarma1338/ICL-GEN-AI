# ==============================================================================
# WriteWise AI — Environment Configuration Example
# Copy this file to '.env' and fill in your actual credentials:
#   copy .env.example .env
# ==============================================================================

# Default LLM Provider: 'groq' or 'gemini' or 'offline'
LLM_PROVIDER=groq

# Groq API Configuration (Recommended Default)
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini Configuration (Optional Alternative)
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Vector DB & Chunking Settings (Optional defaults)
EMBEDDING_MODEL=all-MiniLM-L6-v2
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=100
DEFAULT_TOP_K=4
DEFAULT_SIMILARITY_THRESHOLD=0.25
